# Copy to .env and change the values for your local MySQL instance.
DB_NAME=ecommerce_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
PORT=3001
# Set this before deploying anywhere public. Enter it in the admin dashboard.
# ADMIN_API_KEY=replace-with-a-long-random-secret
# NODE_ENV=production
# DB_LOG_SQL=false
# Alternatively use DATABASE_URL=mysql://user:password@host:3306/ecommerce_db
